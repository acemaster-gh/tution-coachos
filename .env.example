# ─────────────────────────────────────────────────────────────
# SUPABASE (Phase 8 — replaces the old JSON-file storage)
# ─────────────────────────────────────────────────────────────
# From your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# DANGER: full database access, bypasses Row Level Security entirely.
# Server-only — NEVER prefix this with NEXT_PUBLIC_, never send it to
# the browser. Used only in src/utils/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Which institute this deployment serves. This app is single-institute
# per deployment (see README) — the public lead form and notification
# audit log need to know which institutes.id row to write against.
# Create the institutes row yourself (see DEPLOYMENT.md) and paste its
# UUID here.
INSTITUTE_ID=

# ─────────────────────────────────────────────────────────────
# SESSION
# ─────────────────────────────────────────────────────────────
# No longer used for auth (Supabase Auth owns that now), but keep this
# set anyway if any custom server-side signing is added later.
SESSION_SECRET=

# ─────────────────────────────────────────────────────────────
# RAZORPAY (Phase 4 — fee payments)
# ─────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Required for /api/billing/webhook to accept payment confirmations —
# set this to the same secret you configure in the Razorpay dashboard's
# webhook settings. Without it, the webhook route refuses all requests
# (503) rather than silently accepting unverified ones.
RAZORPAY_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────
# NOTIFICATIONS (Phase 6)
# ─────────────────────────────────────────────────────────────
# Resend (email). Get a free API key at resend.com. Without these,
# emails are logged to the server console instead of sent.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Twilio (WhatsApp/SMS). Get credentials at twilio.com/console. Without
# these, messages are logged instead of sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# Where institute-side alerts (new enquiries) land. Falls back to the
# contact info in src/config/site.ts if unset.
ADMIN_NOTIFY_EMAIL=
ADMIN_NOTIFY_PHONE=

# Protects /api/billing/reminders and /api/alerts/check — these run real
# background jobs (send notifications) and must not be publicly callable.
# Set this to a long random string, and pass it as
# `Authorization: Bearer <value>` when triggering them. Without it in
# production, these routes refuse all requests (503) rather than
# silently staying open.
CRON_SECRET=
