# Copy to .env.local and set a real random value before deploying anywhere
# beyond your own machine. Without this, auth falls back to an insecure
# dev-only secret (see src/lib/auth.ts).
SESSION_SECRET=

# Razorpay (Phase 4 — fee payments). Get test-mode keys free at
# dashboard.razorpay.com. Without these, the "Pay" button shows a clear
# "not configured" message instead of crashing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Resend (Phase 6 — email notifications). Get a free API key at
# resend.com. Without these, emails are logged to the server console
# instead of actually sent — nothing breaks, you just won't get a real
# email until these are set.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Twilio (Phase 6 — WhatsApp/SMS notifications). Get credentials at
# twilio.com/console. TWILIO_WHATSAPP_FROM needs a WhatsApp-enabled
# sender (Twilio's sandbox number works for testing). Without these,
# messages are logged instead of sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# Where institute-side alerts (new enquiries) land. Falls back to the
# contact info in src/config/site.ts if unset.
ADMIN_NOTIFY_EMAIL=
ADMIN_NOTIFY_PHONE=
